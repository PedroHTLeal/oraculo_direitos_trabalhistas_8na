# Copie este arquivo para automacao/.env (ou rode automacao/iniciar-automacao.bat,
# que cria o .env com valores aleatórios). O .env nunca é enviado ao GitHub.

# Senha combinada entre o Oráculo e o n8n: deve ser igual a N8N_TOKEN no backend/.env
ORACULO_TOKEN=
# Chave de acesso da Evolution API (usada no painel http://localhost:8080/manager e pelo n8n)
EVOLUTION_API_KEY=
# Senha do banco de dados da Evolution API
POSTGRES_SENHA=
# Opcional: versão do WhatsApp Web, só se o QR code não aparecer (ver docs/configuracao.md)
WHATSAPP_WEB_VERSAO=
