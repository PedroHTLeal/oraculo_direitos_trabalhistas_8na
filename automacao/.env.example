# Copie este arquivo para automacao/.env (ou rode automacao/iniciar-automacao.bat,
# que cria o .env com valores aleatórios). O .env nunca é enviado ao GitHub.

# Senha combinada entre o Oráculo e o n8n: deve ser igual a N8N_TOKEN no backend/.env
ORACULO_TOKEN=
# Chave interna entre o n8n e o WAHA (qualquer texto longo e aleatório)
WAHA_API_KEY=
# Senha do painel do WAHA (usuário: admin), em http://localhost:3000/dashboard
WAHA_SENHA_PAINEL=
