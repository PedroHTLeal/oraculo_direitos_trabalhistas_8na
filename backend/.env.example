# Copie este arquivo para .env e preencha com os seus valores.
# O .env nunca é enviado ao GitHub.

# Supabase: Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (IA, plano gratuito): aistudio.google.com > Get API key
GEMINI_API_KEY=AQ.Ab8RN6IvZUOIabwmvRA7K5rRNINZ_5SQlGaVmJoxfHDBGHvHNQ
# Opcional: modelo do Gemini (padrão: gemini-flash-latest)
GEMINI_MODELO=

# Serviço de WhatsApp: "meta" (WhatsApp Cloud API, oficial) ou "twilio" (Sandbox)
PROVEDOR_WHATSAPP=meta

# WhatsApp Cloud API (Meta): developers.facebook.com > seu app > WhatsApp > Configuração da API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Número de teste mostrado no campo "De" (From), ex.: +1 555 123 4567
META_WHATSAPP_NUMERO=
# Opcional: versão da API do Facebook (padrão: v23.0)
META_WHATSAPP_VERSAO_API=

# Twilio: console.twilio.com (Account Info) e Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do Sandbox do WhatsApp, no formato +14155238886
TWILIO_WHATSAPP_NUMERO=+14155238886
# Código do Sandbox (a mensagem que o usuário envia, ex.: "join palavra-palavra")
TWILIO_SANDBOX_CODIGO=
