# Copie este arquivo para .env e preencha com os seus valores.
# O .env nunca é enviado ao GitHub.

# Supabase: Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (IA, plano gratuito): aistudio.google.com > Get API key
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-flash-latest)
GEMINI_MODELO=

# Automação do WhatsApp (n8n): veja docs/configuracao.md, seção 3
N8N_WEBHOOK_URL=http://localhost:5678/webhook/oraculo-whatsapp
# Mesmo valor de ORACULO_TOKEN em automacao/.env
N8N_TOKEN=
