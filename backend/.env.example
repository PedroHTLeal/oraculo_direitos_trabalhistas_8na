# Copie este arquivo para .env e preencha com os seus valores.
# O .env nunca é enviado ao GitHub.

# Supabase: Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (IA, plano gratuito): aistudio.google.com > Get API key
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-flash-latest)
GEMINI_MODELO=

# Envio de e-mails pelo Gmail: veja docs/configuracao.md, seção 3
# Conta do Gmail que envia os e-mails e a senha de app dela (16 letras)
EMAIL_REMETENTE=
EMAIL_SENHA_APP=
